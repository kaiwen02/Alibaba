# Atlas Configuration
ATLAS_MODE=demo
ATLAS_SANDBOX_URL=https://sandbox.atriptech.com
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journeyguard

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) - ticket confirmation emails
# Leave EMAIL_ENABLED=false to run the demo with no email delivery at all.
# To enable: sign up at resend.com, create an API key, and set EMAIL_TO_OVERRIDE
# to your signup email (the free tier only delivers to that address).
EMAIL_ENABLED=false
RESEND_API_KEY=
# onboarding@resend.dev is Resend's shared test sender - works without a verified domain.
EMAIL_FROM="Pathfinder Demo <onboarding@resend.dev>"
# Optional: force all demo ticket emails to one inbox for testing
EMAIL_TO_OVERRIDE=

# Demo Mode Settings
DEMO_SCENARIO=success
