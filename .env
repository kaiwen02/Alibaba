# Atlas Configuration
ATLAS_MODE=demo
ATLAS_SANDBOX_URL=https://sandbox.atriptech.com
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:Password1234@localhost:5432/journeyguard

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production-generate-a-real-one

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Settings
DEMO_SCENARIO=success

# AI Rebooking Pipeline (LLM)
# Provider: ollama | dashscope | mock
LLM_PROVIDER=ollama
# Comma-separated OllamaFreeAPI nodes (empty = built-in community node pool).
# Models auto-resolve per node via /api/tags when OLLAMA_MODEL is unavailable.
OLLAMA_BASE_URLS=
OLLAMA_MODEL=deepseek-r1:latest
LLM_TIMEOUT_MS=90000
# DashScope (Alibaba Qwen) — only used when LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
